# Copy to .env.local and fill in. Never commit .env.local.

# SerpApi — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Anthropic — https://console.anthropic.com (used to classify review evidence)
ANTHROPIC_API_KEY=

# Live SerpApi calls are OFF unless set to "on". When off, the app serves
# committed snapshots in data/snapshots (real SerpApi results, labelled with fetch time).
LIVE_SEARCH=off

# Hard guards for live mode
SERPAPI_DAILY_CREDIT_CAP=40
SERPAPI_MIN_CREDITS_LEFT=15
LIVE_RUNS_PER_IP_PER_HOUR=3
